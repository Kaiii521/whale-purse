{
  "name": "whale-purse",
  "version": "0.2.0",
  "type": "module",
  "description": "鲸鱼钱包：给 whale-girl 桌宠加上余额提示、花费提示与峰谷提示（菜单按钮唤出，每步浮现花费）",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "whale-girl",
    "balance",
    "pet"
  ],
  "license": "MIT",
  "private": true
}
